{
  "name": "portfolio",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "build:full": "vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "NODE_ENV=production node dist/index.js",
    "preview": "vite preview --host",
    "check": "tsc --noEmit",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@chakra-ui/react": "^3.0.0-next.32",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "clsx": "^2.1.1",
    "express": "^4.21.2",
    "i18next": "^25.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-i18next": "^16.5.3",
    "react-icons": "^5.5.0",
    "sonner": "^2.0.7",
    "wouter": "^3.3.5"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "^0.25.0",
    "prettier": "^3.6.2",
    "typescript": "5.6.3",
    "vite": "^7.1.7"
  }
}
